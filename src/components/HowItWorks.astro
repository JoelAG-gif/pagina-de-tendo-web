---
const steps = [
  { n: 'n1', num: '1', title: 'Descarga gratis la app',       desc: 'Descarga TENDŌ KŌRE desde el enlace que te compartimos. La instalas directamente en tu Android sin necesidad de Play Store. Solo activa "Fuentes desconocidas".' },
  { n: 'n2', num: '2', title: 'Prueba 7 días gratis',         desc: 'Apenas instales tienes 7 días completos para probar todas las funciones. Sin compromisos, sin tarjeta, sin nada. Conoce la app antes de decidir.' },
  { n: 'n3', num: '3', title: 'Contáctanos por WhatsApp',     desc: 'Si te convence, escríbenos. Te enviamos el código de activación al instante después de tu pago por Yape, Plin o transferencia.' },
  { n: 'n4', num: '4', title: '¡Activa y listo para siempre!', desc: 'Ingresa tu código en la app y queda activada de por vida. Un solo pago, sin mensualidades, sin vencimientos. La app es tuya.' },
];
---

<section class="how-bg" id="como-funciona">
  <div class="section-label reveal">Simple y rápido</div>
  <h2 class="section-title reveal">¿Cómo funciona?</h2>
  <p class="section-desc reveal">En 4 pasos tienes TENDŌ KŌRE corriendo en tu celular, listo para gestionar tu negocio.</p>

  <div class="steps">
    {steps.map((s) => (
      <div class="step reveal">
        <div class={`step-num ${s.n}`}>{s.num}</div>
        <div class="step-body">
          <div class="step-title">{s.title}</div>
          <div class="step-desc">{s.desc}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.how-bg {
  background: #0a1f06; position: relative;
  padding: 100px 60px;
}
.how-bg::before {
  content: ''; position: absolute; inset: 0;
  background-image: linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),
                    linear-gradient(90deg,rgba(255,255,255,.015) 1px,transparent 1px);
  background-size: 32px 32px;
}
.section-label {
  font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 7px;
  color: rgba(244,166,42,0.6); text-transform: uppercase;
  text-align: center; margin-bottom: 16px;
}
.section-title {
  font-family: 'Cinzel Decorative', serif;
  font-size: clamp(28px,4vw,44px); color: #fff;
  text-align: center; margin-bottom: 16px; letter-spacing: 2px;
}
.section-desc {
  font-size: 15px; color: rgba(255,255,255,0.4); text-align: center;
  max-width: 540px; margin: 0 auto 70px; line-height: 1.9; letter-spacing: 0.5px;
}
.steps {
  display: flex; flex-direction: column; gap: 0;
  max-width: 700px; margin: 0 auto; position: relative;
}
.steps::before {
  content: ''; position: absolute; left: 28px; top: 0; bottom: 0; width: 1px;
  background: linear-gradient(180deg,transparent,rgba(244,166,42,0.3),rgba(39,174,96,0.3),transparent);
}
.step { display: flex; gap: 32px; align-items: flex-start; padding: 36px 0; position: relative; }
.step-num {
  width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Cinzel Decorative', serif; font-size: 18px; font-weight: 700;
  position: relative; z-index: 1; color: #fff;
}
.n1 { background: linear-gradient(135deg,#e8531a,#f4a62a); box-shadow: 0 0 30px rgba(232,83,26,0.4); }
.n2 { background: linear-gradient(135deg,#f4a62a,#e8531a); box-shadow: 0 0 30px rgba(244,166,42,0.4); }
.n3 { background: linear-gradient(135deg,#27ae60,#1e8449); box-shadow: 0 0 30px rgba(39,174,96,0.4); }
.n4 { background: linear-gradient(135deg,#e8531a,#27ae60); box-shadow: 0 0 30px rgba(232,83,26,0.3); }
.step-body { padding-top: 12px; }
.step-title { font-family: 'Cinzel', serif; font-size: 15px; letter-spacing: 2px; color: #fff; margin-bottom: 8px; text-transform: uppercase; }
.step-desc  { font-size: 14px; color: rgba(255,255,255,0.45); line-height: 1.85; }

@media (max-width: 768px) { .how-bg { padding: 80px 24px; } }
</style>

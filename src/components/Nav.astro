---
const WSP = '51960756758';
const msgGeneral = encodeURIComponent('Hola! 😊 Vi la pagina de TENDŌ KŌRE y me interesa la app.\n\nMis consultas: 📋\n📱 Como descargo la app?\n🔑 Como funciona la activacion?\n📊 Cual es la diferencia entre Basico y Premium?\n\nGracias!');

// Si estamos en una subpágina, los links deben incluir /# en vez de solo #
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/index.html';
const prefix = isHome ? '' : '/';
---

<nav id="navbar">
  <a class="nav-logo" href="/">
    <div class="nav-logo-dot"></div>
    TENDŌ KŌRE
  </a>

  <div class="nav-links">
    <a href={`${prefix}#inicio`}>Inicio</a>
    <a href={`${prefix}#funciones`}>Funciones</a>
    <a href={`${prefix}#como-funciona`}>Como Funciona</a>
    <a href={`${prefix}#precios`}>Precios</a>
    <a href={`https://wa.me/${WSP}?text=${msgGeneral}`}
       target="_blank"
       class="nav-cta">
      Obtener App
    </a>
  </div>

  <div class="nav-hamburger" id="hamburger">
    <span></span><span></span><span></span>
  </div>
</nav>

<!-- Menú móvil -->
<div class="nav-mobile" id="mobileMenu">
  <div class="nav-mobile-logo">TENDŌ KŌRE</div>
  <div class="nav-mobile-sep"></div>
  <a href={`${prefix}#inicio`} class="mob-link">Inicio</a>
  <a href={`${prefix}#funciones`} class="mob-link">Funciones</a>
  <a href={`${prefix}#como-funciona`} class="mob-link">Como Funciona</a>
  <a href={`${prefix}#precios`} class="mob-link">Precios</a>
  <a href={`https://wa.me/${WSP}?text=${msgGeneral}`}
     target="_blank"
     class="mob-cta">
    Obtener App
  </a>
</div>

<style>
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 60px;
  background: rgba(8,22,5,0.92);
  backdrop-filter: blur(24px);
  border-bottom: 1px solid rgba(244,166,42,0.15);
  transition: all 0.3s;
}
nav::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg,transparent,rgba(244,166,42,0.3),rgba(232,83,26,0.3),transparent);
}

/* Logo */
.nav-logo {
  font-family: 'Cinzel Decorative', serif;
  font-size: 22px; font-weight: 700;
  background: linear-gradient(135deg,#f4a62a,#e8531a);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  letter-spacing: 4px; display: flex; align-items: center; gap: 10px;
  text-decoration: none; cursor: pointer;
}
.nav-logo-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: linear-gradient(135deg,#e8531a,#f4a62a);
  box-shadow: 0 0 10px rgba(232,83,26,0.8); flex-shrink: 0;
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%,100% { box-shadow: 0 0 10px rgba(232,83,26,0.8); }
  50%     { box-shadow: 0 0 20px rgba(232,83,26,1), 0 0 40px rgba(244,166,42,0.4); }
}

/* Links */
.nav-links { display: flex; gap: 6px; align-items: center; }
.nav-links a {
  font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 3px;
  color: rgba(255,255,255,0.45); text-decoration: none; text-transform: uppercase;
  transition: all 0.3s; padding: 8px 14px; border-radius: 20px;
  border: 1px solid transparent;
}
.nav-links a:hover {
  color: rgba(244,166,42,0.9);
  border-color: rgba(244,166,42,0.2);
  background: rgba(244,166,42,0.05);
}
.nav-cta {
  background: linear-gradient(135deg,#e8531a,#f4a62a) !important;
  color: #fff !important; border-color: transparent !important;
  padding: 10px 22px !important; font-weight: 700 !important;
  box-shadow: 0 4px 20px rgba(232,83,26,0.4); letter-spacing: 2px !important;
}
.nav-cta:hover { box-shadow: 0 8px 30px rgba(232,83,26,0.6) !important; transform: translateY(-2px); }

/* Hamburger */
.nav-hamburger {
  display: none; flex-direction: column; gap: 5px; cursor: pointer;
  padding: 10px; border-radius: 10px;
  border: 1px solid rgba(244,166,42,0.2);
  background: rgba(244,166,42,0.05);
  transition: all 0.2s; z-index: 101; position: relative;
}
.nav-hamburger:hover { border-color: rgba(244,166,42,0.4); background: rgba(244,166,42,0.1); }
.nav-hamburger span {
  display: block; width: 22px; height: 1.5px;
  background: #f4a62a; border-radius: 2px;
  transition: all 0.3s; transform-origin: center;
}
.nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* Mobile menu */
.nav-mobile {
  display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 99;
  background: rgba(5,12,3,0.98); backdrop-filter: blur(30px);
  flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.nav-mobile.open { opacity: 1; pointer-events: all; }
.nav-mobile-logo {
  font-family: 'Cinzel Decorative', serif; font-size: 28px; letter-spacing: 6px;
  background: linear-gradient(135deg,#f4a62a,#e8531a);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  margin-bottom: 8px;
}
.nav-mobile-sep {
  width: 50px; height: 1px;
  background: linear-gradient(90deg,transparent,rgba(244,166,42,0.4),transparent);
  margin: 16px 0;
}
.nav-mobile a {
  font-family: 'Cinzel', serif; font-size: 13px; letter-spacing: 5px;
  color: rgba(255,255,255,0.55); text-decoration: none; text-transform: uppercase;
  padding: 16px 48px; border-radius: 50px; border: 1px solid transparent;
  transition: all 0.3s; text-align: center; width: 280px;
}
.nav-mobile a:hover { color: #fff; border-color: rgba(244,166,42,0.25); background: rgba(244,166,42,0.06); }
.mob-cta {
  background: linear-gradient(135deg,#e8531a,#f4a62a) !important;
  color: #fff !important; margin-top: 12px;
  box-shadow: 0 8px 30px rgba(232,83,26,0.4);
  border-color: transparent !important;
}

@media (max-width: 768px) {
  nav { padding: 16px 24px; }
  .nav-links { display: none; }
  .nav-hamburger { display: flex; }
  .nav-mobile { display: flex; }
}
</style>

<script>
  const ham = document.getElementById('hamburger')!;
  const menu = document.getElementById('mobileMenu')!;
  const navbar = document.getElementById('navbar')!;

  ham.addEventListener('click', () => {
    ham.classList.toggle('open');
    menu.classList.toggle('open');
    document.body.style.overflow = menu.classList.contains('open') ? 'hidden' : '';
  });

  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      ham.classList.remove('open');
      menu.classList.remove('open');
      document.body.style.overflow = '';
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar.style.padding = '14px 60px';
      navbar.style.background = 'rgba(5,10,3,0.95)';
    } else {
      navbar.style.padding = '18px 60px';
      navbar.style.background = 'rgba(8,22,5,0.92)';
    }
  });
</script>
---
const WSP = '51960756758';

const msgBasico  = encodeURIComponent('Hola! 😊 Vi la pagina de TENDŌ KŌRE y quiero el Plan Basico (S/ 300).\n\nMis consultas: 📋\n💳 Como realizo el pago?\n🔑 Como recibo mi codigo de activacion?\n✅ Puedo probarlo antes?\n\nGracias!');
const msgPremium = encodeURIComponent('Hola! 😊 Vi la pagina de TENDŌ KŌRE y quiero el Plan Premium (S/ 400).\n\nMis consultas: 📋\n💳 Como realizo el pago?\n🔑 Como recibo mi codigo de activacion?\n⭐ Que incluye exactamente el Premium?\n\nGracias!');
---

<section class="pricing-bg" id="precios">
  <div class="section-label reveal">Pago único · Sin mensualidades</div>
  <h2 class="section-title reveal">Elige tu Plan</h2>
  <p class="section-desc reveal">Un solo pago y la app es tuya para siempre. Todo lo que incluye cada plan visible de inmediato.</p>

  <div class="pricing-grid">

    <!-- BÁSICO -->
    <div class="price-card basico reveal">
      <div class="price-card-inner">
        <div class="price-badge hide">·</div>
        <div class="price-tier">Plan Básico</div>
        <div class="price-amount">S/ 300</div>
        <div class="price-note">Pago único · Para siempre</div>
        <div class="price-divider"></div>
        <ul class="price-list">
          <li>✅ Ventas ilimitadas</li>
          <li>✅ Control de inventario</li>
          <li>✅ Fiados y deudas</li>
          <li>✅ Reporte de caja</li>
          <li>✅ Alertas de stock</li>
          <li>✅ Copias de seguridad</li>
          <li>✅ Funciona sin internet</li>
          <li class="no-item">✕ WhatsApp Automático</li>
          <li class="no-item">✕ Reportes Avanzados</li>
        </ul>
        <a href={`https://wa.me/${WSP}?text=${msgBasico}`} target="_blank" class="price-btn price-btn-b">
          Obtener Básico
        </a>
      </div>
    </div>

    <!-- PREMIUM -->
    <div class="price-card premium reveal">
      <div class="price-card-inner">
        <div class="price-badge">⭐ Recomendado</div>
        <div class="price-tier" style="color:#f4a62a;">Plan Premium</div>
        <div class="price-amount price-amount-premium">S/ 400</div>
        <div class="price-note">Pago único · Para siempre</div>
        <div class="price-divider"></div>
        <ul class="price-list">
          <li>✅ Todo lo del Básico</li>
          <li>📱 WhatsApp Automático</li>
          <li>📊 Reportes Avanzados</li>
          <li>💾 Restauración de copias</li>
          <li>✅ Soporte prioritario</li>
          <li>✅ Actualizaciones incluidas</li>
          <li>✅ Ventas ilimitadas</li>
          <li>✅ Fiados y deudas</li>
          <li>✅ Funciona sin internet</li>
        </ul>
        <a href={`https://wa.me/${WSP}?text=${msgPremium}`} target="_blank" class="price-btn price-btn-p">
          Obtener Premium
        </a>
      </div>
    </div>

  </div>
</section>

<style>
.pricing-bg { padding: 100px 60px; }

.section-label {
  font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 7px;
  color: rgba(244,166,42,0.6); text-transform: uppercase;
  text-align: center; margin-bottom: 16px;
}
.section-title {
  font-family: 'Cinzel Decorative', serif;
  font-size: clamp(28px,4vw,44px); color: #fff;
  text-align: center; margin-bottom: 16px; letter-spacing: 2px;
}
.section-desc {
  font-size: 15px; color: rgba(255,255,255,0.4); text-align: center;
  max-width: 540px; margin: 0 auto 70px; line-height: 1.9; letter-spacing: 0.5px;
}
.pricing-grid {
  display: flex; gap: 40px; justify-content: center;
  flex-wrap: wrap; max-width: 960px; margin: 0 auto;
}

/* ── Borde RGB animado ── */
@keyframes rgbBorderSpin {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes rgbGlowPulse {
  0%,100% { box-shadow: 0 0 15px rgba(232,83,26,0.7),0 0 35px rgba(232,83,26,0.35),0 20px 60px rgba(0,0,0,0.6); }
  33%     { box-shadow: 0 0 15px rgba(244,166,42,0.9),0 0 35px rgba(244,166,42,0.45),0 20px 60px rgba(0,0,0,0.6); }
  66%     { box-shadow: 0 0 15px rgba(39,174,96,0.7),0 0 35px rgba(39,174,96,0.35),0 20px 60px rgba(0,0,0,0.6); }
}

.price-card {
  width: 340px; border-radius: 22px;
  position: relative; padding: 2px;
  background: linear-gradient(300deg, #e8531a,#f4a62a,#f4d03f,#27ae60,#f4a62a,#e8531a);
  background-size: 400% 400%;
  animation: rgbBorderSpin 4s ease infinite, rgbGlowPulse 4s ease infinite;
}
.price-card-inner {
  border-radius: 20px; padding: 36px 32px 32px;
  height: 100%; position: relative; overflow: hidden;
}
.basico .price-card-inner  { background: linear-gradient(160deg,#1a1500 0%,#131313 50%,#0f1a0c 100%); }
.premium .price-card-inner { background: linear-gradient(160deg,#1a0800 0%,#131313 50%,#0f1a0c 100%); }
.price-card-inner::before {
  content: ''; position: absolute; inset: 0; border-radius: 20px;
  background: radial-gradient(ellipse at 30% 20%,rgba(244,166,42,0.08),transparent 55%);
  pointer-events: none;
}

.price-badge {
  display: inline-block;
  background: linear-gradient(135deg,#e8531a,#f4a62a);
  color: #fff; font-family: 'Cinzel', serif; font-size: 8px; letter-spacing: 2px;
  padding: 5px 16px; border-radius: 20px; text-transform: uppercase;
  margin-bottom: 20px; box-shadow: 0 4px 15px rgba(232,83,26,0.4);
}
.price-badge.hide { opacity: 0; pointer-events: none; }

.price-tier {
  font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 5px;
  color: rgba(255,255,255,0.45); text-transform: uppercase; margin-bottom: 10px;
}
.price-amount {
  font-family: 'Cinzel Decorative', serif; font-size: 64px; font-weight: 700;
  line-height: 1; margin-bottom: 6px; color: #fff;
  text-shadow: 0 0 30px rgba(244,166,42,0.3);
}
.price-amount-premium {
  background: linear-gradient(135deg,#f4a62a,#e8531a);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  text-shadow: none;
}
.price-note { font-size: 12px; color: rgba(255,255,255,0.3); letter-spacing: 1px; font-style: italic; margin-bottom: 28px; }
.price-divider { width: 100%; height: 1px; background: linear-gradient(90deg,transparent,rgba(255,255,255,0.1),transparent); margin-bottom: 24px; }

.price-list { list-style: none; display: flex; flex-direction: column; gap: 9px; margin-bottom: 28px; }
.price-list li { font-size: 13px; color: rgba(255,255,255,0.7); display: flex; align-items: center; gap: 8px; line-height: 1.4; }
.no-item { color: rgba(255,255,255,0.22) !important; }

.price-btn {
  display: block; width: 100%; text-align: center; text-decoration: none;
  padding: 13px; border-radius: 50px;
  font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 3px;
  font-weight: 700; text-transform: uppercase; transition: all 0.2s; cursor: pointer;
}
.price-btn-b { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.2); }
.price-btn-b:hover { background: rgba(255,255,255,0.15); border-color: rgba(244,166,42,0.4); }
.price-btn-p { background: linear-gradient(135deg,#e8531a,#f4a62a); color: #fff; border: none; box-shadow: 0 6px 20px rgba(232,83,26,0.5); }
.price-btn-p:hover { box-shadow: 0 10px 35px rgba(232,83,26,0.7); transform: translateY(-2px); }

@media (max-width: 768px) {
  .pricing-bg { padding: 80px 24px; }
  .price-card { width: 100%; max-width: 340px; }
  .pricing-grid { flex-direction: column; align-items: center; }
}
</style>

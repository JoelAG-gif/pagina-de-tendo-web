---
const WSP = '51960756758';
const msg = encodeURIComponent('Hola! 😊 Vi la pagina de TENDŌ KŌRE y me interesa la app.\n\nMis consultas: 📋\n📱 Como descargo la app?\n🔑 Como funciona la activacion?\n📊 Cual es la diferencia entre Basico y Premium?\n\nGracias!');
---

<section class="cta-section" id="contacto">
  <h2 class="cta-title reveal">¿Listo para tomar el control?</h2>
  <p class="cta-desc reveal">Escríbenos por WhatsApp ahora mismo. Te respondemos al instante y te enviamos la app para que empieces hoy.</p>

  <a href={`https://wa.me/${WSP}?text=${msg}`} target="_blank" class="wsp-btn reveal">
    <svg class="wsp-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    Escribir por WhatsApp
  </a>
  <div class="cta-note reveal">Lunes a Domingo · Respuesta inmediata</div>
</section>

<style>
.cta-section {
  background: linear-gradient(160deg,#1a0800,#0a1f06,#0d0d0d);
  text-align: center; padding: 120px 60px;
  position: relative; overflow: hidden;
}
.cta-section::before {
  content: ''; position: absolute;
  width: 600px; height: 600px; border-radius: 50%;
  background: radial-gradient(circle,rgba(244,166,42,0.08),transparent 70%);
  top: 50%; left: 50%; transform: translate(-50%,-50%);
}
.cta-title {
  font-family: 'Cinzel Decorative', serif;
  font-size: clamp(28px,4vw,48px); color: #fff;
  margin-bottom: 20px; position: relative;
}
.cta-desc {
  font-size: 15px; color: rgba(255,255,255,0.4);
  max-width: 480px; margin: 0 auto 48px; line-height: 1.9; position: relative;
}
.wsp-btn {
  display: inline-flex; align-items: center; gap: 14px;
  background: linear-gradient(135deg,#25D366,#128C7E);
  color: #fff; text-decoration: none;
  padding: 20px 50px; border-radius: 60px;
  font-family: 'Cinzel', serif; font-size: 13px; letter-spacing: 3px; font-weight: 700; text-transform: uppercase;
  box-shadow: 0 12px 40px rgba(37,211,102,0.35);
  transition: all 0.2s; position: relative;
}
.wsp-btn:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(37,211,102,0.5); }
.wsp-icon { width: 26px; height: 26px; flex-shrink: 0; }
.cta-note { margin-top: 24px; font-size: 11px; color: rgba(255,255,255,0.2); letter-spacing: 2px; font-style: italic; }

@media (max-width: 768px) { .cta-section { padding: 80px 24px; } }
</style>

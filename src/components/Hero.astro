---
const WSP = '51960756758';
const msgGeneral = encodeURIComponent('Hola! 😊 Vi la pagina de TENDŌ KŌRE  y me interesa la app.\n\nMis consultas: 📋\n📱 Como descargo la app?\n🔑 Como funciona la activacion?\n📊 Cual es la diferencia entre Basico y Premium?\n\nGracias!');
---

<section class="hero" id="inicio">
  <div class="hero-bg"></div>
  <div class="hero-glow"></div>
  <div class="hero-glow2"></div>
  <div class="hero-grid"></div>
  <div class="hero-lines"></div>
  <div class="particles" id="particles"></div>

  <div class="corner c-tl"></div>
  <div class="corner c-tr"></div>
  <div class="corner c-bl"></div>
  <div class="corner c-br"></div>

  <div class="hero-content">
    <div class="hero-icon">
      <div class="stall-wrap">
        <div class="s-roof1"></div>
        <div class="s-roof2"></div>
        <div class="s-body">
          <div class="s-dot" style="background:#e74c3c;box-shadow:0 0 6px rgba(231,76,60,.8);"></div>
          <div class="s-dot" style="background:#f4d03f;box-shadow:0 0 6px rgba(244,208,63,.8);"></div>
          <div class="s-dot" style="background:#27ae60;box-shadow:0 0 6px rgba(39,174,96,.8);"></div>
          <div class="s-dot" style="background:#e67e22;box-shadow:0 0 6px rgba(230,126,34,.8);"></div>
          <div class="s-dot" style="background:#8e44ad;box-shadow:0 0 6px rgba(142,68,173,.7);"></div>
        </div>
      </div>
    </div>

    <div class="hero-pre">Novark Systems · 2026</div>
    <div class="hero-title">TENDŌ KŌRE</div>
    <div class="hero-sub">Control Total</div>
    <div class="hero-divider"><div class="gem"></div></div>
    <div class="hero-desc">Gestión inteligente para<br/>tu negocio del mercado</div>

    <div class="hero-dots">
      <div class="h-dot" style="width:8px;height:8px;background:#e74c3c;box-shadow:0 0 10px rgba(231,76,60,.7);"></div>
      <div class="h-dot" style="width:7px;height:7px;background:#f4d03f;box-shadow:0 0 10px rgba(244,208,63,.7);"></div>
      <div class="h-dot" style="width:8px;height:8px;background:#27ae60;box-shadow:0 0 10px rgba(39,174,96,.7);"></div>
      <div class="h-dot" style="width:7px;height:7px;background:#e67e22;box-shadow:0 0 10px rgba(230,126,34,.7);"></div>
      <div class="h-dot" style="width:8px;height:8px;background:#8e44ad;box-shadow:0 0 10px rgba(142,68,173,.6);"></div>
    </div>

    <div class="hero-btns">
      <a href={`https://wa.me/${WSP}?text=${msgGeneral}`} target="_blank" class="btn-primary">
        <span>📱</span> Obtener App
      </a>
      <a href="#funciones" class="btn-secondary">
        <span>✦</span> Ver Funciones
      </a>
    </div>
  </div>

  <div class="hero-stats">
    <div class="stat">
      <div class="stat-num">99%</div>
      <div class="stat-label">Sin Internet</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat">
      <div class="stat-num">∞</div>
      <div class="stat-label">Licencia de por vida</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat">
      <div class="stat-num">0</div>
      <div class="stat-label">Mensualidades</div>
    </div>
  </div>
</section>

<style>
.hero {
  min-height: 100vh; position: relative;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  overflow: hidden; padding: 120px 24px 80px;
}
.hero-bg {
  position: absolute; inset: 0;
  background: linear-gradient(170deg,#0a1f06 0%,#122a0a 20%,#1c3d10 40%,#2a1500 65%,#1a0d00 85%,#0d0600 100%);
}
.hero-glow {
  position: absolute; width: 700px; height: 700px; border-radius: 50%;
  background: radial-gradient(circle,rgba(244,166,42,0.12) 0%,rgba(232,83,26,0.06) 40%,transparent 70%);
  top: 50%; left: 50%; transform: translate(-50%,-55%); pointer-events: none;
}
.hero-glow2 {
  position: absolute; width: 500px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle,rgba(39,174,96,0.08) 0%,transparent 70%);
  bottom: -100px; left: 50%; transform: translateX(-50%); pointer-events: none;
}
.hero-grid {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
                    linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
  background-size: 28px 28px;
}
.hero-lines { position: absolute; inset: 0; overflow: hidden; }
.hero-lines::before {
  content: ''; position: absolute; width: 200%; height: 1px;
  background: linear-gradient(90deg,transparent,rgba(244,166,42,0.25),transparent);
  top: 40%; left: -50%; transform: rotate(-6deg);
}
.hero-lines::after {
  content: ''; position: absolute; width: 200%; height: 1px;
  background: linear-gradient(90deg,transparent,rgba(39,174,96,0.2),transparent);
  top: 62%; left: -50%; transform: rotate(-6deg);
}
.particles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }

/* Corners */
.corner { position: absolute; width: 28px; height: 28px; }
.corner::before,.corner::after { content: ''; position: absolute; background: rgba(244,166,42,0.45); }
.corner::before { width: 100%; height: 1.5px; }
.corner::after  { width: 1.5px; height: 100%; }
.c-tl { top: 30px; left: 30px; }
.c-tr { top: 30px; right: 30px; transform: scaleX(-1); }
.c-bl { bottom: 30px; left: 30px; transform: scaleY(-1); }
.c-br { bottom: 30px; right: 30px; transform: scale(-1); }

.hero-content { position: relative; z-index: 2; text-align: center; max-width: 800px; }

/* Icon */
.hero-icon {
  width: 110px; height: 110px; border-radius: 26px;
  background: linear-gradient(145deg,#1a0a00,#2d1200,#1f3d10,#0d2d05);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 32px; position: relative; overflow: hidden;
  box-shadow: 0 16px 50px rgba(0,0,0,0.6),0 0 30px rgba(244,166,42,0.15),inset 0 1px 0 rgba(255,255,255,0.06);
  animation: iconFloat 4s ease-in-out infinite;
}
@keyframes iconFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
.hero-icon::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse at 40% 30%,rgba(244,166,42,0.22),transparent 55%);
}
.stall-wrap { position: relative; width: 70px; height: 60px; z-index: 1; }
.s-roof1 {
  position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 35px solid transparent; border-right: 35px solid transparent;
  border-bottom: 20px solid #e8531a;
  filter: drop-shadow(0 3px 6px rgba(232,83,26,0.6));
}
.s-roof2 {
  position: absolute; top: 5px; left: 50%; transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 29px solid transparent; border-right: 29px solid transparent;
  border-bottom: 17px solid #f4a62a;
  filter: drop-shadow(0 2px 4px rgba(244,166,42,0.4));
}
.s-body {
  position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 54px; height: 28px;
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14);
  border-radius: 2px 2px 4px 4px;
  display: flex; align-items: center; justify-content: center; gap: 4px;
}
.s-dot { width: 8px; height: 8px; border-radius: 50%; }

/* Texto */
.hero-pre {
  font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 7px;
  color: rgba(244,166,42,0.6); text-transform: uppercase;
  margin-bottom: 16px; animation: fadeUp 0.8s 0.2s both;
}
.hero-title {
  font-family: 'Cinzel Decorative', serif;
  font-size: clamp(52px,8vw,88px); font-weight: 700;
  color: #fff; letter-spacing: 6px; line-height: 1;
  text-shadow: 0 0 40px rgba(244,166,42,0.4),0 0 80px rgba(232,83,26,0.2),0 4px 12px rgba(0,0,0,0.8);
  animation: fadeUp 0.8s 0.4s both; margin-bottom: 8px;
}
.hero-sub {
  font-family: 'Cinzel Decorative', serif;
  font-size: clamp(10px,1.5vw,14px); letter-spacing: 10px;
  color: rgba(244,166,42,0.8); text-transform: uppercase;
  animation: fadeUp 0.8s 0.6s both; margin-bottom: 28px;
}
.hero-divider {
  display: flex; align-items: center; gap: 12px;
  justify-content: center; margin: 0 auto 28px; width: 160px;
  animation: fadeUp 0.8s 0.7s both;
}
.hero-divider::before { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg,transparent,rgba(232,83,26,0.5)); }
.hero-divider::after  { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg,rgba(39,174,96,0.5),transparent); }
.gem {
  width: 7px; height: 7px;
  background: linear-gradient(135deg,#f4a62a,#e8531a);
  transform: rotate(45deg); box-shadow: 0 0 10px rgba(244,166,42,0.6);
}
.hero-desc {
  font-size: 16px; color: rgba(255,255,255,0.45); line-height: 1.9;
  font-weight: 300; font-style: italic; letter-spacing: 1.5px;
  animation: fadeUp 0.8s 0.8s both; margin-bottom: 48px;
}
.hero-dots { display: flex; gap: 10px; justify-content: center; margin-bottom: 52px; animation: fadeUp 0.8s 0.9s both; }
.h-dot { border-radius: 50%; }

/* Botones */
.hero-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; animation: fadeUp 0.8s 1s both; }
.btn-primary {
  display: flex; align-items: center; gap: 10px;
  background: linear-gradient(135deg,#e8531a,#f4a62a);
  color: #fff; text-decoration: none;
  padding: 16px 36px; border-radius: 50px;
  font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 3px; font-weight: 700; text-transform: uppercase;
  box-shadow: 0 8px 30px rgba(232,83,26,0.45);
  transition: transform 0.2s, box-shadow 0.2s;
}
.btn-primary:hover { transform: translateY(-3px); box-shadow: 0 16px 50px rgba(232,83,26,0.6); }
.btn-secondary {
  display: flex; align-items: center; gap: 10px;
  background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); text-decoration: none;
  padding: 16px 36px; border-radius: 50px;
  font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 3px; font-weight: 600; text-transform: uppercase;
  border: 1px solid rgba(255,255,255,0.12); transition: all 0.2s;
}
.btn-secondary:hover { background: rgba(255,255,255,0.1); border-color: rgba(244,166,42,0.3); color: #fff; }

/* Stats */
.hero-stats {
  display: flex; gap: 60px; justify-content: center; margin-top: 72px;
  animation: fadeUp 0.8s 1.1s both; position: relative; z-index: 2;
}
.stat { text-align: center; }
.stat-num {
  font-family: 'Cinzel Decorative', serif; font-size: 36px; font-weight: 700;
  background: linear-gradient(135deg,#f4a62a,#e8531a);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.stat-label { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 4px; color: rgba(255,255,255,0.35); text-transform: uppercase; margin-top: 4px; }
.stat-sep { width: 1px; background: rgba(255,255,255,0.08); align-self: stretch; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }

/* Particles */
:global(.particle) { position: absolute; border-radius: 50%; animation: particleFloat linear infinite; opacity: 0; }
@keyframes particleFloat {
  0%   { opacity: 0; transform: translateY(0) scale(0); }
  10%  { opacity: 0.6; }
  90%  { opacity: 0.3; }
  100% { opacity: 0; transform: translateY(-100vh) scale(1); }
}

@media (max-width: 768px) {
  .hero-stats { gap: 20px; flex-wrap: wrap; }
  .hero-stats .stat-sep { display: none; }
  .hero-btns { flex-direction: column; align-items: center; }
  .btn-primary, .btn-secondary { width: 100%; max-width: 300px; justify-content: center; }
}
</style>

<script>
  // Partículas flotantes
  const container = document.getElementById('particles')!;
  const colors = ['#e8531a','#f4a62a','#27ae60','#f4d03f'];
  for (let i = 0; i < 25; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const size = Math.random() * 4 + 2;
    const color = colors[Math.floor(Math.random() * colors.length)];
    p.style.cssText = `
      width:${size}px;height:${size}px;background:${color};
      left:${Math.random()*100}%;bottom:${Math.random()*-20}%;
      animation-duration:${Math.random()*12+8}s;
      animation-delay:${Math.random()*8}s;
      box-shadow:0 0 ${size*2}px ${color};
    `;
    container.appendChild(p);
  }
</script>

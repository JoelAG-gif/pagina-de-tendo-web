---
const WSP = '51960756758';
---

<footer>
  <div class="footer-logo">TENDŌ</div>
  <div class="footer-copy">© 2026 Novark S.A.C. · Todos los derechos reservados</div>
  <div class="footer-links">
    <a href="#inicio">Inicio</a>
    <a href="#funciones">Funciones</a>
    <a href="#precios">Precios</a>
    <a href={`https://wa.me/${WSP}`} target="_blank">WhatsApp</a>
  </div>
</footer>

<style>
footer {
  background: #050d03;
  border-top: 1px solid rgba(255,255,255,0.05);
  padding: 48px 60px;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 20px;
}
.footer-logo {
  font-family: 'Cinzel Decorative', serif; font-size: 18px; letter-spacing: 3px;
  background: linear-gradient(135deg,#f4a62a,#e8531a);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.footer-copy { font-size: 11px; color: rgba(255,255,255,0.2); letter-spacing: 2px; }
.footer-links { display: flex; gap: 28px; }
.footer-links a {
  font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 3px;
  color: rgba(255,255,255,0.3); text-decoration: none; text-transform: uppercase;
  transition: color 0.2s;
}
.footer-links a:hover { color: #f4a62a; }

@media (max-width: 768px) {
  footer { flex-direction: column; text-align: center; padding: 40px 24px; }
  .footer-links { justify-content: center; flex-wrap: wrap; gap: 16px; }
}
</style>
